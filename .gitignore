# ---------------------------------------------------------------------------
# 本项目专属规则（在上面 GitHub 通用模板之后追加，模板里与本项目冲突的写法在此纠正）
# ---------------------------------------------------------------------------
# 模板里的 *.spec 会把打包配置一起排除掉，但这些 .spec 是本项目必需的源文件
# （README「打包为 Windows 免安装 exe」与 build_exe.py / build_exe38.py 的前置检查都依赖它们）
!excel2mysql.spec
!packtest.spec
!excel2mysql_cli38.spec
!packtest38.spec

# pyenv 的版本指针是本机的选择：GUI 线用 3.12、Win7 线用 3.8.10，两套并存。
# 把这个文件入库会把别人的 pyenv 一起钉到 3.8，GUI 线反而起不来。
.python-version

# 打包产物：build_exe.py 现场生成，不入库（模板只写了 build/ 与 dist/）
dist_packtest/
build_packtest/
dist_packtest38/
build_packtest38/

# PyCharm 工程状态（模板里 .idea/ 是注释掉的）
.idea/

# Excel 临时锁文件
~$*

# 打包时生成的版本/提交/构建时间戳；开发态缺失属正常（appinfo 会退回查 git）
build_stamp.py

# 填了真实口令的本地连接配置永不入库（模板是 assets/conn.ini，那份要提交）
/conn.ini

# Java 线（P1 阶段用 javac 直编的产物目录；接进 Maven 后改由 target/ 覆盖）
java/out/

# Win7 前置补丁包：43 MB 的微软 .msu 与 vc_redist，按"内部使用"授权分发，不进公开仓库。
# 打包时由 build_exe38.py 原样拷进 dist\excel2mysql-cli\win7_sp1_patch\ 并逐文件核 md5；
# 目录不在就照常出包，但日志与产物说明都会明写"本次没带补丁"。
win7_sp1_patch/
